---
import type { PillItem } from '../lib/config';

interface Props {
  items: PillItem[];
  groupId: string;
}
const { items, groupId } = Astro.props;
---

<div data-pill-group={groupId}>
  <div class="flex flex-wrap gap-3">
    {items.map((item, i) => (
      <button
        type="button"
        class="pill-btn text-sm font-medium border border-navy/15 rounded-full px-4 py-2 text-navy/78 hover:border-navy/40 transition-colors"
        data-index={i}
        aria-expanded="false"
      >
        {item.name}
      </button>
    ))}
  </div>
  <div class="pill-desc mt-4 text-sm text-navy/80 leading-relaxed hidden border-l-2 border-teal pl-4 py-1"></div>
</div>

<script define:vars={{ items, groupId }}>
  const group = document.querySelector(`[data-pill-group="${groupId}"]`);
  if (group) {
    const buttons = group.querySelectorAll('.pill-btn');
    const descBox = group.querySelector('.pill-desc');
    let activeIndex = null;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.dataset.index);
        buttons.forEach((b) => {
          b.classList.remove('bg-navy', 'text-white', 'border-navy');
          b.setAttribute('aria-expanded', 'false');
        });
        if (activeIndex === idx) {
          descBox.classList.add('hidden');
          activeIndex = null;
          return;
        }
        btn.classList.add('bg-navy', 'text-white', 'border-navy');
        btn.setAttribute('aria-expanded', 'true');
        descBox.textContent = items[idx].desc;
        descBox.classList.remove('hidden');
        activeIndex = idx;
      });
    });
  }
</script>
