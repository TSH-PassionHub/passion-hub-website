---
interface Props {
  variant?: 'full' | 'mark';
  class?: string;
}
const { variant = 'full', class: className = '' } = Astro.props;
---

{variant === 'full' ? (
  <div class={`flex items-center gap-3 ${className}`}>
    <svg width="40" height="40" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="18" y="18" width="64" height="64" stroke="#00C2CC" stroke-width="8" fill="none"/>
      <path d="M78 14 L30 86 L42 86 L90 14 Z" fill="#F01E2C"/>
    </svg>
    <div class="leading-tight">
      <div class="font-display font-semibold text-lg tracking-tight">Passion Hub</div>
      <div class="text-[10px] uppercase tracking-widest text-navy/60 accent-slant font-display">Branding &amp; Digital Marketing</div>
    </div>
  </div>
) : (
  <svg width="40" height="40" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class={className} aria-hidden="true">
    <rect x="18" y="18" width="64" height="64" stroke="#00C2CC" stroke-width="8" fill="none"/>
    <path d="M78 14 L30 86 L42 86 L90 14 Z" fill="#F01E2C"/>
  </svg>
)}
