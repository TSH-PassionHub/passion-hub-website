---
// Social Media Management package tier cards + comparison table.
// Used on both /packages and /services/social-media-management so the two
// pages always show identical, up-to-date package details — edit here once.
import {
  SHOW_PRICING,
  FB_MESSENGER_URL,
  packageTiers,
  comparisonRows,
  feeDropCallout,
} from '../lib/config';

interface Props {
  eyebrow?: string;
  heading?: string;
}
const { eyebrow = 'Social Media Packages', heading = 'Ongoing management, three ways to scale.' } = Astro.props;
---

<section class="max-w-6xl mx-auto px-6 py-20 md:py-28">
  <span class="text-xs uppercase tracking-[0.2em] text-coral font-semibold">{eyebrow}</span>
  <h2 class="font-display text-3xl md:text-4xl mt-4 mb-4 max-w-xl">{heading}</h2>

  <div class="grid md:grid-cols-3 gap-6 mt-10">
    {packageTiers.map(tier => (
      <div class={`reveal p-8 border flex flex-col ${tier.featured ? 'bg-navy text-white border-navy' : 'bg-offwhite border-navy/10'}`}>
        {tier.featured && <span class="text-xs uppercase tracking-widest text-teal font-semibold mb-2">Most popular</span>}
        <div class="flex items-baseline gap-2">
          <h3 class="font-display text-2xl font-semibold">{tier.name}</h3>
          <span class={`font-display accent-slant text-lg ${tier.featured ? 'text-teal' : 'text-coral'}`}>"{tier.nickname}"</span>
        </div>
        <p class={`mt-3 text-xs font-semibold uppercase tracking-wide ${tier.featured ? 'text-white/50' : 'text-navy/55'}`}>{tier.bestFor}</p>
        <p class={`mt-3 text-sm ${tier.featured ? 'text-white/65' : 'text-navy/70'}`}>
          {tier.tagline}
          {tier.feeCallout && <strong> — {tier.feeCallout}.</strong>}
        </p>

        <div class="mt-6 mb-2">
          {SHOW_PRICING ? (
            <>
              <span class="font-display text-3xl font-semibold">{tier.price}</span>
              <span class={tier.featured ? 'text-white/60 text-sm' : 'text-navy/60 text-sm'}>{tier.period}</span>
            </>
          ) : (
            <span class={`inline-block text-xs font-semibold uppercase tracking-wider px-3 py-1.5 rounded-full ${tier.featured ? 'bg-teal/20 text-teal' : 'bg-coral/10 text-coral'}`}>
              Custom Quote
            </span>
          )}
        </div>
        <div class={`text-xs mb-6 ${tier.featured ? 'text-white/50' : 'text-navy/58'}`}>{tier.postCount}</div>

        <ul class="space-y-3 text-sm flex-1">
          {tier.deliverables.map(d => (
            <li class={`flex gap-2 ${tier.featured ? 'text-white/80' : 'text-navy/78'}`}>
              <span class="text-teal mt-0.5">&#10003;</span>
              <span>{d}</span>
            </li>
          ))}
        </ul>

        <a
          href={SHOW_PRICING ? '/contact' : FB_MESSENGER_URL}
          target={SHOW_PRICING ? undefined : '_blank'}
          rel={SHOW_PRICING ? undefined : 'noopener noreferrer'}
          class={`mt-8 inline-flex items-center justify-center text-sm font-semibold px-6 py-3 rounded-sm transition-colors ${tier.featured ? 'bg-coral text-white hover:bg-coral/90' : 'bg-navy text-white hover:bg-navy-light'}`}
        >
          {SHOW_PRICING ? 'Get Started' : 'Get a Quote'}
        </a>
      </div>
    ))}
  </div>

  <div class="mt-8 p-6 border-l-4 border-teal bg-teal/5 flex items-start gap-4">
    <span class="text-teal text-2xl leading-none">&#8595;</span>
    <p class="text-sm text-navy/85 leading-relaxed">{feeDropCallout}</p>
  </div>
</section>

<!-- COMPARE PACKAGES -->
<section class="bg-cream/50">
  <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
    <span class="text-xs uppercase tracking-[0.2em] text-coral font-semibold">Compare</span>
    <h2 class="font-display text-3xl md:text-4xl mt-4 mb-6 max-w-xl">Standard vs Advanced vs Premium.</h2>
    <p class="text-sm text-navy/62 mb-8 md:hidden">&larr; Swipe to compare all three tiers &rarr;</p>

    <div class="overflow-x-auto relative">
      <table class="w-full border-collapse min-w-[640px]">
        <thead>
          <tr class="border-b border-navy/15">
            <th class="text-left py-4 pr-4 text-sm font-semibold text-navy/70">Feature</th>
            {packageTiers.map(tier => (
              <th class="text-left py-4 px-4 font-display text-lg font-semibold">{tier.name}</th>
            ))}
          </tr>
        </thead>
        <tbody class="text-sm">
          {comparisonRows.map(row => (
            <tr class="border-b border-navy/10">
              <td class="py-4 pr-4 text-navy/70">{row.feature}</td>
              {row.values.map(v => (
                <td class={`py-4 px-4 ${v === '✓' ? 'text-teal' : v === '—' ? 'text-navy/42' : ''}`}>{v}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
