---
// Reusable lead-generation section: a lightweight contact form (Name, Phone,
// Message) plus Messenger / phone / email, all wired to the same Web3Forms
// endpoint as the main Contact page. Drop this onto any page that should
// give visitors a fast way to reach out without linking away to /contact.
import {
  FB_MESSENGER_URL,
  VIBER_DISPLAY,
  VIBER_HREF,
  CONTACT_EMAIL,
  CONTACT_PHONE_DISPLAY,
  CONTACT_PHONE_HREF,
  WEB3FORMS_ACCESS_KEY,
  SERVICE_INQUIRY_OPTIONS,
} from '../lib/config';

interface Props {
  heading: string;
  subtext?: string;
  /** Shown in the email subject line so you know which page a lead came from. */
  sourceLabel: string;
  /** Pre-selects the matching option in the Service dropdown, e.g. on an individual service page. */
  defaultService?: string;
  /** Unique id prefix — only needs to change if this component is ever used twice on one page. */
  id?: string;
  maxWidth?: string;
}
const { heading, subtext, sourceLabel, defaultService = '', id = 'cta', maxWidth = 'max-w-6xl' } = Astro.props;

const formId = `${id}-form`;
const statusId = `${id}-status`;
const btnId = `${id}-btn`;
---

<section id="contact" class="relative bg-navy text-white overflow-hidden">
  <div class="absolute inset-0 opacity-[0.05]" style="background-image: repeating-linear-gradient(115deg, transparent, transparent 40px, white 41px, white 42px);"></div>
  <div class={`${maxWidth} mx-auto px-6 py-20 md:py-28 relative grid md:grid-cols-5 gap-12 items-start min-w-0`}>
    <div class="md:col-span-2 text-center md:text-left min-w-0">
      <h2 class="font-display text-3xl md:text-4xl leading-tight">{heading}</h2>
      {subtext && <p class="mt-4 text-white/70 leading-relaxed">{subtext}</p>}

      <div class="mt-8 flex flex-col gap-3 items-center md:items-start">
        <a href={FB_MESSENGER_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-semibold text-white hover:text-teal transition-colors">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2C6.48 2 2 6.15 2 11.27c0 2.91 1.44 5.51 3.7 7.21V22l3.38-1.86c.9.25 1.87.38 2.92.38 5.52 0 10-4.15 10-9.27S17.52 2 12 2z" fill="currentColor"/></svg>
          Chat on Messenger
        </a>
        <a href={VIBER_HREF} class="inline-flex items-center gap-2 text-sm font-semibold text-white hover:text-teal transition-colors">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2C6.5 2 2 5.9 2 10.7c0 2.8 1.5 5.3 3.9 6.9-.1.9-.5 2.4-.6 2.8-.1.4.1.4.3.3.2-.1 2.5-1.6 3.5-2.3.9.2 1.9.3 2.9.3 5.5 0 10-3.9 10-8.7S17.5 2 12 2z" fill="currentColor"/></svg>
          <span>Viber: {VIBER_DISPLAY}</span>
        </a>
        <a href={CONTACT_PHONE_HREF} class="inline-flex items-center gap-2 text-sm font-semibold text-white hover:text-teal transition-colors">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.3 21 3 13.7 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z" fill="currentColor"/></svg>
          {CONTACT_PHONE_DISPLAY}
        </a>
        <a href={`mailto:${CONTACT_EMAIL}`} class="inline-flex items-center gap-2 text-sm font-semibold text-white hover:text-teal transition-colors break-all">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6h18v12H3V6z" stroke="currentColor" stroke-width="1.5"/><path d="M3 6l9 7 9-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {CONTACT_EMAIL}
        </a>
      </div>
    </div>

    <form id={formId} class="md:col-span-3 min-w-0 bg-white/5 border border-white/10 rounded-sm p-6 md:p-8 space-y-4">
      <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
      <input type="hidden" name="subject" value={`New inquiry from Passion Hub website — ${sourceLabel}`} />
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

      <div class="grid sm:grid-cols-2 gap-4 min-w-0">
        <div>
          <label for={`${formId}-name`} class="block text-xs font-medium text-white/70 mb-1.5">Name <span class="text-teal">*</span></label>
          <input required type="text" id={`${formId}-name`} name="name" class="w-full border border-white/20 bg-transparent px-4 py-2.5 text-sm text-white focus:outline-none focus:border-teal" />
        </div>
        <div>
          <label for={`${formId}-phone`} class="block text-xs font-medium text-white/70 mb-1.5">Phone <span class="text-teal">*</span></label>
          <input required type="tel" id={`${formId}-phone`} name="phone" class="w-full border border-white/20 bg-transparent px-4 py-2.5 text-sm text-white focus:outline-none focus:border-teal" />
        </div>
      </div>

      <div>
        <label for={`${formId}-service`} class="block text-xs font-medium text-white/70 mb-1.5">Service Interested In <span class="text-teal">*</span></label>
        <select required id={`${formId}-service`} name="service" class="w-full min-w-0 border border-white/20 bg-navy px-4 py-2.5 text-sm text-white focus:outline-none focus:border-teal">
          <option value="">Select a service&hellip;</option>
          {SERVICE_INQUIRY_OPTIONS.map(s => <option value={s} selected={s === defaultService}>{s}</option>)}
        </select>
      </div>

      <div>
        <label for={`${formId}-message`} class="block text-xs font-medium text-white/70 mb-1.5">Message <span class="text-white/45 font-normal">(optional)</span></label>
        <textarea id={`${formId}-message`} name="message" rows="3" class="w-full border border-white/20 bg-transparent px-4 py-2.5 text-sm text-white focus:outline-none focus:border-teal"></textarea>
      </div>

      <button type="submit" id={btnId} class="inline-flex items-center justify-center bg-coral text-white text-sm font-semibold px-7 py-3 rounded-sm hover:bg-coral/90 transition-colors disabled:opacity-60 w-full sm:w-auto">
        Send Message
      </button>
      <p id={statusId} class="text-sm" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script define:vars={{ formId, statusId, btnId }}>
  const form = document.getElementById(formId);
  const status = document.getElementById(statusId);
  const btn = document.getElementById(btnId);

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status || !btn) return;

    const accessKey = form.querySelector('[name="access_key"]')?.value;
    if (!accessKey || accessKey.startsWith('REPLACE_WITH')) {
      status.textContent = "Form isn't fully connected yet — please reach us via Messenger, phone, or email in the meantime.";
      status.className = 'text-sm text-coral';
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Sending…';
    status.textContent = '';

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const result = await res.json();
      if (result.success) {
        window.location.href = '/thank-you';
        return;
      } else {
        throw new Error(result.message || 'Something went wrong');
      }
    } catch {
      status.textContent = 'Something went wrong sending this. Please try Messenger, phone, or email instead.';
      status.className = 'text-sm text-coral';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send Message';
    }
  });
</script>
