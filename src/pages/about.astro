---
import Layout from '../layouts/Layout.astro';
import WorkCarousel from '../components/WorkCarousel.astro';
import { whyPassionHub, portfolioItems, testimonials, pageMeta, SECTION_VISIBILITY } from '../lib/config';

const industries = ['F&B', 'Healthcare', 'Hygiene', 'Beauty', 'Hospitality', 'Social Business Units', 'Human Resources', 'Finance', 'B2B'];
---

<Layout title={pageMeta.about.title} description={pageMeta.about.description}>
  <section class="bg-navy text-white">
    <div class="max-w-6xl mx-auto px-6 pt-24 pb-20 md:pt-28 md:pb-24">
      <div class="flex items-center gap-3 mb-6">
        <span class="h-px w-10 bg-coral"></span>
        <span class="text-xs uppercase tracking-[0.2em] text-teal font-semibold">About Passion Hub</span>
      </div>
      <h1 class="font-display text-4xl md:text-6xl leading-tight max-w-2xl">
        Strategy and creativity, <span class="accent-slant text-teal">built to grow brands.</span>
      </h1>
    </div>
  </section>

  <!-- WHO WE ARE -->
  <section class="max-w-6xl mx-auto px-6 py-20 md:py-28 grid md:grid-cols-5 gap-12 items-start">
    <div class="md:col-span-2">
      <span class="text-xs uppercase tracking-[0.2em] text-coral font-semibold">Who We Are</span>
      <h2 class="font-display text-3xl md:text-4xl mt-4 leading-tight">A decade of building brands that grow.</h2>
    </div>
    <div class="md:col-span-3">
      <p class="text-navy/75 leading-relaxed text-lg">
        Passion Hub is a Myanmar-based branding and digital marketing agency led by a team with combined expertise in building and growing brands across F&amp;B, Healthcare, Beauty, Hospitality, Recruitment, B2B, and Social Business sectors.
      </p>
      <p class="mt-5 text-navy/75 leading-relaxed text-lg">
        With hands-on experience in both agency and in-house settings — and regional exposure across Cambodia, Laos, and Thailand — we bring proven, practical marketing know-how to every project.
      </p>
      <div class="mt-8 flex flex-wrap gap-2">
        {industries.map(ind => (
          <span class="text-xs font-medium border border-navy/15 rounded-full px-3.5 py-1.5 text-navy/70">{ind}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- OUR APPROACH -->
  <section class="bg-navy text-white">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <span class="text-xs uppercase tracking-[0.2em] text-teal font-semibold">Strategy + Creativity + Execution</span>
      <h2 class="font-display text-3xl md:text-4xl mt-4 max-w-xl">How we think about marketing.</h2>
      <p class="mt-6 text-white/65 max-w-2xl leading-relaxed">
        Every project starts with understanding your brand and audience, then comes to life through creative execution — disciplined, on-brand, and measured against real outcomes.
      </p>
    </div>
  </section>

  <!-- MISSION & VISION -->
  <section class="max-w-6xl mx-auto px-6 py-20 md:py-28 grid md:grid-cols-2 gap-10">
    <div class="p-8 border border-navy/10 bg-cream/50">
      <span class="text-xs uppercase tracking-[0.2em] text-coral font-semibold">Our Mission</span>
      <p class="font-display text-2xl mt-4 leading-snug">To help brands move further, faster — with marketing that's grounded in strategy and brought to life through creativity.</p>
    </div>
    <div class="p-8 border border-navy/10 bg-cream/50">
      <span class="text-xs uppercase tracking-[0.2em] text-coral font-semibold">Our Vision</span>
      <p class="font-display text-2xl mt-4 leading-snug">To be the region's most trusted branding and digital marketing partner for businesses ready to grow beyond their borders.</p>
    </div>
  </section>

  <!-- WHY PASSION HUB -->
  <section class="bg-cream/50">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <span class="text-xs uppercase tracking-[0.2em] text-coral font-semibold">Why Passion Hub</span>
      <h2 class="font-display text-3xl md:text-4xl mt-4 mb-14 max-w-xl">Four reasons brands stay with us.</h2>
      <div class="grid sm:grid-cols-2 gap-px bg-navy/10 border border-navy/10">
        {whyPassionHub.map(w => (
          <div class="bg-offwhite p-8">
            <h3 class="font-display text-xl font-semibold mb-2">{w.title}</h3>
            <p class="text-sm text-navy/65 leading-relaxed">{w.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS (structural — renders only once real client testimonials are added) -->
  {testimonials.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <span class="text-xs uppercase tracking-[0.2em] text-coral font-semibold">What Clients Say</span>
      <h2 class="font-display text-3xl md:text-4xl mt-4 mb-14">Trusted by growing brands.</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {testimonials.map(t => (
          <div class="p-8 border border-navy/10 bg-offwhite">
            <p class="text-navy/75 leading-relaxed italic">&ldquo;{t.quote}&rdquo;</p>
            <div class="mt-6 text-sm font-semibold">{t.clientName}</div>
            <div class="text-xs text-navy/50">{t.position}, {t.company}</div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- SELECTED WORK — carousel (toggle: SECTION_VISIBILITY.aboutClientWork in config.ts) -->
  {SECTION_VISIBILITY.aboutClientWork && (
    <section class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <span class="text-xs uppercase tracking-[0.2em] text-coral font-semibold">Selected Work</span>
      <h2 class="font-display text-3xl md:text-4xl mt-4 mb-14">Visual highlights from our client work.</h2>
      <WorkCarousel items={portfolioItems} />
    </section>
  )}

  <!-- CTA -->
  <section class="relative bg-navy text-white overflow-hidden">
    <div class="max-w-6xl mx-auto px-6 py-24 md:py-32 text-center">
      <h2 class="font-display text-4xl md:text-5xl leading-tight max-w-2xl mx-auto">
        Let's <span class="accent-slant text-teal">work together.</span>
      </h2>
      <div class="mt-10">
        <a href="/contact" class="inline-flex items-center justify-center bg-coral text-white text-sm font-semibold px-8 py-4 rounded-sm hover:bg-coral/90 transition-colors">
          Let's Talk
        </a>
      </div>
    </div>
  </section>
</Layout>
