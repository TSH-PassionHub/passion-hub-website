---
import Layout from '../layouts/Layout.astro';
import ExpandablePillList from '../components/ExpandablePillList.astro';
import ContactCTA from '../components/ContactCTA.astro';
import SocialMediaPackages from '../components/SocialMediaPackages.astro';
import {
  projectBasedServices,
  addOnServices,
  trainingPackages,
  FB_MESSENGER_URL,
  pageMeta,
} from '../lib/config';
---

<Layout title={pageMeta.packages.title} description={pageMeta.packages.description}>
  <section class="bg-navy text-white">
    <div class="max-w-6xl mx-auto px-6 pt-24 pb-20 md:pt-28 md:pb-24">
      <div class="flex items-center gap-3 mb-6">
        <span class="h-px w-10 bg-coral"></span>
        <span class="text-xs uppercase tracking-[0.2em] text-teal font-semibold">Packages</span>
      </div>
      <h1 class="font-display text-4xl md:text-6xl leading-tight max-w-2xl">
        Flexible marketing <span class="accent-slant text-teal">packages</span> built to fit.
      </h1>
      <p class="mt-6 text-white/65 max-w-lg leading-relaxed">
        From ongoing social media management to one-off projects, every package is scoped around what your brand actually needs — not a one-size-fits-all bundle.
      </p>
    </div>
  </section>

  <SocialMediaPackages />

  <!-- TRAINING PACKAGES -->
  <section class="bg-cream/50">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <span class="text-xs uppercase tracking-[0.2em] text-coral font-semibold">Training &amp; Workshops</span>
      <h2 class="font-display text-3xl md:text-4xl mt-4 mb-4 max-w-xl">Four ways to build marketing capability.</h2>
      <p class="text-sm text-navy/70 leading-relaxed max-w-2xl mb-10">Practical, hands-on marketing training for teams and individuals.</p>
      <div class="grid md:grid-cols-2 gap-6">
        {trainingPackages.map(pkg => (
          <div class="p-8 border border-navy/10 bg-offwhite flex flex-col">
            <h3 class="font-display text-xl font-semibold mb-2">{pkg.name}</h3>
            <p class="text-xs font-semibold uppercase tracking-wide text-navy/55 mb-3">{pkg.bestFor}</p>
            <p class="text-sm text-navy/78 leading-relaxed mb-4">{pkg.desc}</p>
            <p class="text-sm text-navy/62 leading-relaxed mb-6 pt-4 border-t border-navy/10">
              <span class="font-semibold text-navy/75">Suggested structure: </span>{pkg.structure}
            </p>
            <a href={FB_MESSENGER_URL} target="_blank" rel="noopener noreferrer" class="mt-auto inline-flex items-center justify-center bg-navy text-white text-sm font-semibold px-6 py-3 rounded-sm hover:bg-navy-light transition-colors">
              Ask About This
            </a>
          </div>
        ))}
      </div>
      <p class="mt-6 text-xs text-navy/55 leading-relaxed max-w-2xl">
        Session counts, cadence, and pricing above are starting suggestions — every engagement is scoped to fit your team, so exact details are confirmed with you directly before a session is booked.
      </p>
    </div>
  </section>

  <!-- PROJECT-BASED SERVICES -->
  <section class="max-w-6xl mx-auto px-6 py-20 md:py-28">
    <span class="text-xs uppercase tracking-[0.2em] text-coral font-semibold">Project-Based Services</span>
    <h2 class="font-display text-3xl md:text-4xl mt-4 mb-4 max-w-xl">One-off projects, scoped to you.</h2>
    <p class="text-sm text-navy/62 mb-8">Tap a service to see what's included.</p>
    <div class="mb-16">
      <ExpandablePillList items={projectBasedServices} groupId="packages-project" />
    </div>

    <span class="text-xs uppercase tracking-[0.2em] text-coral font-semibold">Add-On Services</span>
    <h2 class="font-display text-3xl md:text-4xl mt-4 mb-4 max-w-xl">Extend any package as you grow.</h2>
    <p class="text-sm text-navy/62 mb-8">Tap a service to see what's included.</p>
    <ExpandablePillList items={addOnServices} groupId="packages-addon" />
  </section>

  <!-- FINAL CTA -->
  <ContactCTA
    id="packages-cta"
    heading="Not sure which package is right for you?"
    subtext="Tell us about your brand and goals — we'll recommend the right fit, no pressure."
    sourceLabel="Packages Page"
  />
</Layout>
