---
import Layout from '../layouts/Layout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { getCollection } from 'astro:content';
import {
  SHOW_PRICING,
  packageTiers,
  serviceCategories,
  whyPassionHub,
  testimonials,
  pageMeta,
} from '../lib/config';

const stats = [
  { target: 10, suffix: '+', label: 'Years of Industry Experience' },
  { target: 4, suffix: '', label: 'Countries (Regional Expertise)' },
  { target: 100, suffix: '%', label: 'Client-First Process' },
];

const process = [
  { title: 'Brand Briefing', desc: 'We start by understanding your brand, audience, and goals — before recommending anything.' },
  { title: 'Planning & Execution', desc: 'Strategy becomes a content and campaign plan, executed on schedule.' },
  { title: 'Review & Improvement', desc: 'Every campaign is measured, reviewed, and refined for stronger performance next time.' },
];

const latestInsights = (await getCollection('insights', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const dateFmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<Layout title={pageMeta.home.title} description={pageMeta.home.description}>
  <section class="relative bg-navy text-white overflow-hidden">
    <div class="absolute inset-0 opacity-[0.07]" style="background-image: repeating-linear-gradient(115deg, transparent, transparent 40px, white 41px, white 42px);"></div>
    <div class="max-w-6xl mx-auto px-6 pt-24 pb-28 md:pt-32 md:pb-36 relative">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-8">
          <span class="h-px w-10 bg-coral"></span>
          <span class="text-xs uppercase tracking-[0.2em] text-teal font-semibold">Branding &amp; Digital Marketing</span>
        </div>
        <h1 class="font-display text-5xl md:text-7xl leading-[1.05] font-medium">
          Marketing that moves you <span class="accent-slant text-teal">further</span>, faster.
        </h1>
        <p class="mt-8 text-lg text-white/70 max-w-xl leading-relaxed">
          A decade of expertise in branding and digital marketing — helping Myanmar businesses build brands that grow, backed by a team with hands-on regional experience across Cambodia, Laos, and Thailand.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="/services" class="inline-flex items-center bg-coral text-white text-sm font-semibold px-7 py-3.5 rounded-sm hover:bg-coral/90 transition-colors">
            Explore Our Services
          </a>
          <a href="/contact" class="inline-flex items-center border border-white/30 text-white text-sm font-semibold px-7 py-3.5 rounded-sm hover:bg-white/10 transition-colors">
            Let's Talk
          </a>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 w-full h-16 md:h-24 bg-offwhite" style="clip-path: polygon(0 100%, 100% 40%, 100% 100%);"></div>
  </section>

  <section class="max-w-6xl mx-auto px-6 -mt-2 md:mt-0 py-16 md:py-24">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-6 md:gap-6">
      {stats.map((s, i) => (
        <div class={`flex flex-col items-center text-center ${i > 0 ? 'border-t sm:border-t-0 sm:border-l border-navy/10 pt-6 sm:pt-0 sm:pl-6' : ''}`}>
          <div class="stat-number font-display text-4xl md:text-5xl font-semibold text-navy" data-target={s.target} data-suffix={s.suffix}>0{s.suffix}</div>
          <div class="mt-2 text-sm text-navy/78 leading-snug">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-cream/50">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28 grid md:grid-cols-5 gap-12 items-center">
      <div class="md:col-span-3">
        <span class="text-xs uppercase tracking-[0.2em] text-coral font-semibold">A Decade of Building Brands That Grow</span>
        <h2 class="font-display text-3xl md:text-4xl mt-4 leading-tight">A decade of building brands that grow.</h2>
        <p class="mt-5 text-navy/82 leading-relaxed text-lg">
          Passion Hub is led by a team with deep, combined expertise across F&amp;B, Healthcare, Beauty, Hospitality, Recruitment, B2B, and Social Business Units. Based in Myanmar, we bring hands-on experience and a proven track record of helping brands grow — with regional expertise extending across Cambodia, Laos, and Thailand.
        </p>
        <a href="/about" class="inline-flex items-center gap-1.5 mt-6 text-sm font-semibold text-navy hover:text-coral transition-colors">
          More About Us <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <div class="md:col-span-2 aspect-[4/3] overflow-hidden border border-navy/10">
        <img src="/images/general/team-collaboration.webp" alt="Passion Hub team collaborating in a strategy session" width="1000" height="1000" class="w-full h-full object-cover" loading="lazy" />
      </div>
    </div>
  </section>

  <section id="services" class="max-w-6xl mx-auto px-6 py-20 md:py-28">
    <div class="flex items-end justify-between flex-wrap gap-4 mb-14">
      <div>
        <span class="text-xs uppercase tracking-[0.2em] text-coral font-semibold">What We Do</span>
        <h2 class="font-display text-3xl md:text-4xl mt-4">Everything your brand needs to move.</h2>
      </div>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-navy/10 border border-navy/10 [&>*]:min-w-0">
      {serviceCategories.map(s => (
        <a href={s.external || `/services/${s.slug}`} class="reveal bg-offwhite p-8 hover:bg-white transition-colors">
          <h3 class="font-display text-xl font-semibold mb-2">{s.name}</h3>
          <p class="text-sm text-navy/75 leading-relaxed">{s.desc}</p>
        </a>
      ))}
    </div>
    <div class="mt-10 text-center">
      <a href="/services" class="inline-flex items-center justify-center gap-2 bg-coral text-white text-base font-semibold px-10 py-4 rounded-sm hover:bg-coral/90 transition-colors shadow-lg shadow-coral/20">
        Explore All Our Services <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <section class="bg-navy text-white">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <span class="text-xs uppercase tracking-[0.2em] text-teal font-semibold">Why Passion Hub</span>
      <h2 class="font-display text-3xl md:text-4xl mt-4 mb-14 max-w-xl">Four reasons brands stay with us.</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10">
        {whyPassionHub.map(w => (
          <div class="slash-accent pl-6">
            <h3 class="font-display text-lg font-semibold mb-2">{w.title}</h3>
            <p class="text-white/65 text-sm leading-relaxed">{w.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="pricing" class="bg-cream/50">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <span class="text-xs uppercase tracking-[0.2em] text-coral font-semibold">Packages</span>
      <h2 class="font-display text-3xl md:text-4xl mt-4 mb-14 max-w-xl">Social media management, three ways to scale.</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {packageTiers.map(tier => (
          <div class={`p-8 border ${tier.featured ? 'bg-navy text-white border-navy' : 'bg-offwhite border-navy/10'}`}>
            {tier.featured && <span class="text-xs uppercase tracking-widest text-teal font-semibold">Most popular</span>}
            <div class="flex items-baseline gap-2 mt-2">
              <h3 class="font-display text-2xl font-semibold">{tier.name}</h3>
              <span class={`font-display accent-slant text-sm ${tier.featured ? 'text-teal' : 'text-coral'}`}>"{tier.nickname}"</span>
            </div>
            <p class={`mt-2 text-sm ${tier.featured ? 'text-white/65' : 'text-navy/70'}`}>{tier.tagline}</p>
            <div class="mt-5">
              {SHOW_PRICING ? (
                <span class="font-display text-2xl font-semibold">{tier.price}<span class={tier.featured ? 'text-white/60 text-sm' : 'text-navy/60 text-sm'}>{tier.period}</span></span>
              ) : (
                <span class={`inline-block text-xs font-semibold uppercase tracking-wider px-3 py-1.5 rounded-full ${tier.featured ? 'bg-teal/20 text-teal' : 'bg-coral/10 text-coral'}`}>Custom Quote</span>
              )}
            </div>
          </div>
        ))}
      </div>
      <a href="/packages" class="inline-flex items-center gap-1.5 mt-8 text-sm font-semibold text-navy hover:text-coral transition-colors">
        See all Packages &amp; Add-Ons <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <section class="bg-navy text-white">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <span class="text-xs uppercase tracking-[0.2em] text-teal font-semibold">How We Work</span>
      <h2 class="font-display text-3xl md:text-4xl mt-4 max-w-xl">A meticulous, insight-driven approach.</h2>
      <div class="mt-14 grid md:grid-cols-3 gap-10">
        {process.map((p, i) => (
          <div class="slash-accent pl-6">
            <div class="text-teal font-display text-sm mb-3">0{i + 1}</div>
            <h3 class="font-display text-xl font-semibold mb-3">{p.title}</h3>
            <p class="text-white/65 text-sm leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <span class="text-xs uppercase tracking-[0.2em] text-coral font-semibold">What Clients Say</span>
      <h2 class="font-display text-3xl md:text-4xl mt-4 mb-14">Trusted by growing brands.</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {testimonials.map(t => (
          <div class="p-8 border border-navy/10 bg-cream/50">
            <p class="text-navy/82 leading-relaxed italic">&ldquo;{t.quote}&rdquo;</p>
            <div class="mt-6 text-sm font-semibold">{t.clientName}</div>
            <div class="text-xs text-navy/62">{t.position}, {t.company}</div>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="max-w-6xl mx-auto px-6 py-20 md:py-28">
    <span class="text-xs uppercase tracking-[0.2em] text-coral font-semibold">Insights</span>
    <h2 class="font-display text-3xl md:text-4xl mt-4 mb-14">Latest thinking from the team.</h2>
    {latestInsights.length > 0 ? (
      <div class="grid md:grid-cols-3 gap-px bg-navy/10 border border-navy/10">
        {latestInsights.map(post => (
          <a href={`/insights/${post.id}/`} class="bg-offwhite hover:bg-white transition-colors flex flex-col">
            <div class="aspect-[16/9] overflow-hidden">
              <img src={post.data.featuredImage || '/images/general/planning-desk.webp'} alt={post.data.featuredImageAlt || post.data.title} width="800" height="450" class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class="p-8 flex flex-col flex-1">
              <div class="flex items-center gap-3 text-xs text-navy/60 mb-4">
                <span class="uppercase tracking-widest text-coral font-semibold">{post.data.category}</span>
                <span>&middot;</span>
                <time datetime={post.data.pubDate.toISOString()}>{dateFmt(post.data.pubDate)}</time>
              </div>
              <h3 class="font-display text-lg font-semibold mb-3 leading-snug">{post.data.title}</h3>
              <span class="mt-auto text-sm font-semibold text-navy inline-flex items-center gap-1.5">
                Read more <span aria-hidden="true">&rarr;</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-navy/70">No posts yet — check back soon.</p>
    )}
    <a href="/insights" class="inline-flex items-center gap-1.5 mt-8 text-sm font-semibold text-navy hover:text-coral transition-colors">
      View All Insights <span aria-hidden="true">&rarr;</span>
    </a>
  </section>

  <ContactCTA
    id="home-cta"
    heading="Ready to move your marketing forward?"
    subtext="Tell us a bit about your brand and we'll get back to you within one business day."
    sourceLabel="Homepage"
  />

  <script>
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const statEls = document.querySelectorAll('.stat-number');

    function animateCount(el: Element) {
      const target = Number(el.getAttribute('data-target') || '0');
      const suffix = el.getAttribute('data-suffix') || '';

      if (prefersReducedMotion) {
        el.textContent = `${target}${suffix}`;
        return;
      }

      const duration = 1200;
      const start = performance.now();

      function tick(now: number) {
        const progress = Math.min((now - start) / duration, 1);
        // easeOutQuad — quick start, gentle settle
        const eased = 1 - (1 - progress) * (1 - progress);
        const current = Math.round(eased * target);
        el.textContent = `${current}${suffix}`;
        if (progress < 1) {
          requestAnimationFrame(tick);
        } else {
          el.textContent = `${target}${suffix}`;
        }
      }
      requestAnimationFrame(tick);
    }

    if ('IntersectionObserver' in window && statEls.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animateCount(entry.target);
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.4 }
      );
      statEls.forEach((el) => observer.observe(el));
    } else {
      // Fallback: no IntersectionObserver support — just show final values.
      statEls.forEach((el) => {
        const target = el.getAttribute('data-target') || '0';
        const suffix = el.getAttribute('data-suffix') || '';
        el.textContent = `${target}${suffix}`;
      });
    }
  </script>
</Layout>
