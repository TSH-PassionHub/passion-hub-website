---
import Layout from '../../layouts/Layout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { servicesData } from '../../lib/servicesData';

export async function getStaticPaths() {
  return servicesData.map(service => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: service.faqs.map(f => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.answer,
    },
  })),
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.eyebrow,
  description: service.metaDescription,
  provider: {
    "@type": "Organization",
    name: "Passion Hub",
  },
  areaServed: "Myanmar",
};
---

<Layout title={service.metaTitle} description={service.metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <section class="bg-navy text-white">
    <div class="max-w-4xl mx-auto px-6 pt-24 pb-20 md:pt-28 md:pb-24">
      <a href="/services" class="text-sm text-teal font-semibold hover:underline">&larr; All Services</a>
      <div class="flex items-center gap-3 mt-8 mb-6">
        <span class="h-px w-10 bg-coral"></span>
        <span class="text-xs uppercase tracking-[0.2em] text-teal font-semibold">{service.eyebrow}</span>
      </div>
      <h1 class="font-display text-4xl md:text-5xl leading-tight max-w-2xl">{service.h1}</h1>
      <p class="mt-6 text-white/70 max-w-2xl leading-relaxed text-lg">{service.intro}</p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-16 md:py-20">
    <span class="text-xs uppercase tracking-[0.2em] text-coral font-semibold">What's Included</span>
    <h2 class="font-display text-2xl md:text-3xl mt-4 mb-10">Here's exactly what this covers.</h2>
    <div class="space-y-8">
      {service.whatsIncluded.map(item => (
        <div class="border-b border-navy/10 pb-8">
          <h3 class="font-display text-xl font-semibold mb-2">{item.name}</h3>
          <p class="text-navy/80 leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-cream/50">
    <div class="max-w-4xl mx-auto px-6 py-16 md:py-20">
      <span class="text-xs uppercase tracking-[0.2em] text-coral font-semibold">How It Works</span>
      <h2 class="font-display text-2xl md:text-3xl mt-4 mb-10">From first conversation to results.</h2>
      <div class="grid sm:grid-cols-2 gap-8">
        {service.howItWorks.map((step, i) => (
          <div class="slash-accent pl-6">
            <div class="text-coral font-display text-sm mb-2">Step {i + 1}</div>
            <h3 class="font-display text-lg font-semibold mb-2">{step.title}</h3>
            <p class="text-sm text-navy/75 leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-16 md:py-20">
    <span class="text-xs uppercase tracking-[0.2em] text-coral font-semibold">Who This Is For</span>
    <p class="mt-4 text-lg text-navy/82 leading-relaxed max-w-2xl">{service.whoFor}</p>
  </section>

  <section class="bg-navy text-white">
    <div class="max-w-4xl mx-auto px-6 py-16 md:py-20">
      <span class="text-xs uppercase tracking-[0.2em] text-teal font-semibold">Frequently Asked Questions</span>
      <h2 class="font-display text-2xl md:text-3xl mt-4 mb-10">Common questions, answered.</h2>
      <div class="space-y-6">
        {service.faqs.map(faq => (
          <div class="border-b border-white/10 pb-6">
            <h3 class="font-display text-lg font-semibold mb-2">{faq.question}</h3>
            <p class="text-white/70 text-sm leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ContactCTA
    id="service-cta"
    heading={service.ctaHeading}
    sourceLabel={`${service.eyebrow} Service Page`}
    maxWidth="max-w-4xl"
  />
</Layout>
