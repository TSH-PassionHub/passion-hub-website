---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { insightCategories, FB_MESSENGER_URL, pageMeta } from '../../lib/config';

const allPosts = (await getCollection('insights', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const [featured, ...rest] = allPosts;

const dateFmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const readTime = (body: string | undefined) => Math.max(1, Math.round((body || '').split(/\s+/).filter(Boolean).length / 200));
---

<Layout title={pageMeta.insights.title} description={pageMeta.insights.description}>
  <section class="bg-navy text-white">
    <div class="max-w-6xl mx-auto px-6 pt-24 pb-16 md:pt-28 md:pb-20">
      <div class="flex items-center gap-3 mb-6">
        <span class="h-px w-10 bg-coral"></span>
        <span class="text-xs uppercase tracking-[0.2em] text-teal font-semibold">Insights</span>
      </div>
      <h1 class="font-display text-4xl md:text-6xl leading-tight max-w-2xl">
        Real-world marketing tips, <span class="accent-slant text-teal">ideas &amp; insights.</span>
      </h1>
      <p class="mt-6 text-white/65 max-w-lg leading-relaxed">Practical marketing, branding, and social media advice from the Passion Hub team, grounded in real client work in Myanmar and across the wider Southeast Asian region.</p>
    </div>
  </section>

  <!-- CATEGORY NAV -->
  <section class="border-b border-navy/10 bg-offwhite sticky top-20 z-30">
    <div class="max-w-6xl mx-auto px-6 flex gap-2 overflow-x-auto py-4">
      {insightCategories.map((cat, i) => (
        <button
          type="button"
          class="category-btn shrink-0 text-sm font-medium px-4 py-2 rounded-full border transition-colors"
          data-category={cat}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {cat}
        </button>
      ))}
    </div>
  </section>

  {featured && (
    <section class="max-w-6xl mx-auto px-6 py-16 md:py-20">
      <span class="text-xs uppercase tracking-[0.2em] text-coral font-semibold">Featured</span>
      <a href={`/insights/${featured.id}/`} class="mt-6 group grid md:grid-cols-5 gap-8 md:gap-12 items-center border border-navy/10 p-8 md:p-10 hover:border-navy/25 transition-colors">
        <div class="md:col-span-2 aspect-[4/3] overflow-hidden border border-navy/10">
          <img src={featured.data.featuredImage || '/images/general/planning-desk.webp'} alt={featured.data.featuredImageAlt || featured.data.title} width="1000" height="1000" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="md:col-span-3">
          <div class="flex items-center gap-3 text-xs text-navy/50 mb-4">
            <span class="uppercase tracking-widest text-coral font-semibold">{featured.data.category}</span>
            <span>&middot;</span>
            <time datetime={featured.data.pubDate.toISOString()}>{dateFmt(featured.data.pubDate)}</time>
            <span>&middot;</span>
            <span>{readTime(featured.body)} min read</span>
          </div>
          <h2 class="font-display text-2xl md:text-3xl font-semibold mb-3 leading-snug group-hover:text-coral transition-colors">{featured.data.title}</h2>
          <p class="text-sm text-navy/65 leading-relaxed mb-4">{featured.data.description}</p>
          <span class="text-sm font-semibold text-navy inline-flex items-center gap-1.5">
            Read more <span aria-hidden="true">&rarr;</span>
          </span>
        </div>
      </a>
    </section>
  )}

  <section class="max-w-6xl mx-auto px-6 py-8 md:py-12">
    <span class="text-xs uppercase tracking-[0.2em] text-coral font-semibold">Latest Insights</span>
    <h2 class="font-display text-2xl md:text-3xl mt-4 mb-10">More from the team.</h2>

    {rest.length === 0 ? (
      <p class="text-navy/60">More posts coming soon — check back shortly.</p>
    ) : (
      <div id="insights-grid" class="grid md:grid-cols-2 gap-px bg-navy/10 border border-navy/10">
        {rest.map(post => (
          <a href={`/insights/${post.id}/`} class="insight-card bg-offwhite hover:bg-white transition-colors flex flex-col" data-category={post.data.category}>
            <div class="aspect-[16/9] overflow-hidden">
              <img src={post.data.featuredImage || '/images/general/planning-desk.webp'} alt={post.data.featuredImageAlt || post.data.title} width="800" height="450" class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class="p-8 flex flex-col flex-1">
              <div class="flex items-center gap-3 text-xs text-navy/50 mb-4">
                <span class="uppercase tracking-widest text-coral font-semibold">{post.data.category}</span>
                <span>&middot;</span>
                <time datetime={post.data.pubDate.toISOString()}>{dateFmt(post.data.pubDate)}</time>
                <span>&middot;</span>
                <span>{readTime(post.body)} min read</span>
              </div>
              <h3 class="font-display text-2xl font-semibold mb-3 leading-snug">{post.data.title}</h3>
              <p class="text-sm text-navy/65 leading-relaxed mb-4">{post.data.description}</p>
              <span class="mt-auto text-sm font-semibold text-navy inline-flex items-center gap-1.5">
                Read more <span aria-hidden="true">&rarr;</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    )}
    <p id="no-results" class="hidden text-navy/50 text-sm mt-6">No posts in this category yet.</p>
  </section>

  <section class="relative bg-navy text-white overflow-hidden">
    <div class="max-w-6xl mx-auto px-6 py-24 md:py-32 text-center">
      <h2 class="font-display text-4xl md:text-5xl leading-tight max-w-2xl mx-auto">
        Need help with your <span class="accent-slant text-teal">marketing?</span>
      </h2>
      <div class="mt-10 flex flex-col sm:flex-row justify-center gap-4">
        <a href="/contact" class="inline-flex items-center justify-center bg-coral text-white text-sm font-semibold px-8 py-4 rounded-sm hover:bg-coral/90 transition-colors">
          Let's Talk
        </a>
        <a href={FB_MESSENGER_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center border border-white/30 text-white text-sm font-semibold px-8 py-4 rounded-sm hover:bg-white/10 transition-colors">
          Chat on Messenger
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .category-btn {
    border-color: color-mix(in srgb, var(--color-navy) 15%, transparent);
    color: color-mix(in srgb, var(--color-navy) 65%, transparent);
  }
  .category-btn[aria-pressed="true"] {
    background: var(--color-navy);
    border-color: var(--color-navy);
    color: white;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.category-btn');
  const cards = document.querySelectorAll<HTMLAnchorElement>('.insight-card');
  const noResults = document.getElementById('no-results');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');
      const cat = btn.dataset.category;

      let visibleCount = 0;
      cards.forEach(card => {
        const show = cat === 'All' || card.dataset.category === cat;
        card.style.display = show ? '' : 'none';
        if (show) visibleCount++;
      });
      if (noResults) noResults.classList.toggle('hidden', visibleCount > 0);
    });
  });
</script>
