---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found | Passion Hub" description="The page you're looking for doesn't exist or may have moved." noindex={true}>
  <section class="bg-navy text-white min-h-[60vh] flex items-center">
    <div class="max-w-2xl mx-auto px-6 py-24 text-center">
      <span class="font-display text-6xl md:text-7xl text-teal">404</span>
      <h1 class="font-display text-2xl md:text-3xl mt-6 mb-4">This page doesn't exist — or it's moved.</h1>
      <p class="text-white/65 leading-relaxed mb-8">
        The link you followed may be outdated, or the page may have been renamed. Try one of these instead:
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/" class="inline-flex items-center justify-center bg-coral text-white text-sm font-semibold px-6 py-3 rounded-sm hover:bg-coral/90 transition-colors">
          Go to Homepage
        </a>
        <a href="/contact" class="inline-flex items-center justify-center border border-white/30 text-white text-sm font-semibold px-6 py-3 rounded-sm hover:bg-white/10 transition-colors">
          Contact Us
        </a>
      </div>
    </div>
  </section>
</Layout>
