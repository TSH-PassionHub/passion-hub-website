---
import Layout from '../layouts/Layout.astro';
import {
  FB_MESSENGER_URL,
  CONTACT_EMAIL,
  CONTACT_PHONE_DISPLAY,
  CONTACT_PHONE_HREF,
  WEB3FORMS_ACCESS_KEY,
  SHOW_SOCIAL_LINKS,
  SOCIAL_LINKS,
  pageMeta,
} from '../lib/config';

const serviceOptions = [
  'Social Media Management',
  'Website Development',
  'App Development',
  'Performance Marketing',
  'SEO & AI Search Optimization',
  'Video Editing / Reels',
  'Logo Design',
  'Something else',
];
---

<Layout title={pageMeta.contact.title} description={pageMeta.contact.description}>
  <section class="bg-navy text-white">
    <div class="max-w-6xl mx-auto px-6 pt-24 pb-16 md:pt-28 md:pb-20">
      <div class="flex items-center gap-3 mb-6">
        <span class="h-px w-10 bg-coral"></span>
        <span class="text-xs uppercase tracking-[0.2em] text-teal font-semibold">Contact</span>
      </div>
      <h1 class="font-display text-4xl md:text-6xl leading-tight max-w-2xl">
        Let's move your marketing <span class="accent-slant text-teal">forward.</span>
      </h1>
      <p class="mt-6 text-white/65 max-w-lg leading-relaxed">Tell us a little about your project and we'll get back to you shortly.</p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16 md:py-24 grid lg:grid-cols-5 gap-14">
    <!-- FORM -->
    <div class="lg:col-span-3">
      <form id="contact-form" class="space-y-6">
        <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
        <input type="hidden" name="subject" value="New inquiry from Passion Hub website" />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

        <div>
          <label for="name" class="block text-sm font-medium mb-2">Name <span class="text-coral">*</span></label>
          <input required type="text" id="name" name="name" class="w-full border border-navy/20 bg-offwhite px-4 py-3 text-sm focus:outline-none focus:border-teal" />
        </div>

        <div>
          <label for="company" class="block text-sm font-medium mb-2">Business / Brand Name <span class="text-navy/40 font-normal">(if applicable)</span></label>
          <input type="text" id="company" name="company" class="w-full border border-navy/20 bg-offwhite px-4 py-3 text-sm focus:outline-none focus:border-teal" />
        </div>

        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <label for="phone" class="block text-sm font-medium mb-2">Phone <span class="text-coral">*</span></label>
            <input required type="tel" id="phone" name="phone" class="w-full border border-navy/20 bg-offwhite px-4 py-3 text-sm focus:outline-none focus:border-teal" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium mb-2">Email <span class="text-navy/40 font-normal">(optional)</span></label>
            <input type="email" id="email" name="email" class="w-full border border-navy/20 bg-offwhite px-4 py-3 text-sm focus:outline-none focus:border-teal" />
          </div>
        </div>

        <div>
          <label for="service" class="block text-sm font-medium mb-2">Service Interested In <span class="text-coral">*</span></label>
          <select required id="service" name="service" class="w-full border border-navy/20 bg-offwhite px-4 py-3 text-sm focus:outline-none focus:border-teal">
            <option value="">Select a service&hellip;</option>
            {serviceOptions.map(s => <option value={s}>{s}</option>)}
          </select>
        </div>

        <div>
          <label for="message" class="block text-sm font-medium mb-2">Message <span class="text-navy/40 font-normal">(optional)</span></label>
          <textarea id="message" name="message" rows="4" class="w-full border border-navy/20 bg-offwhite px-4 py-3 text-sm focus:outline-none focus:border-teal"></textarea>
        </div>

        <button type="submit" id="submit-btn" class="inline-flex items-center justify-center bg-navy text-white text-sm font-semibold px-8 py-4 rounded-sm hover:bg-navy-light transition-colors disabled:opacity-60">
          Send Message
        </button>

        <p id="form-status" class="text-sm mt-3" role="status" aria-live="polite"></p>
      </form>
    </div>

    <!-- OTHER WAYS TO REACH US -->
    <div class="lg:col-span-2">
      <div class="bg-cream/50 p-8">
        <h2 class="font-display text-xl font-semibold mb-6">Other ways to reach us</h2>
        <ul class="space-y-5">
          <li>
            <a href={FB_MESSENGER_URL} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 group">
              <span class="w-10 h-10 rounded-full bg-navy text-white flex items-center justify-center shrink-0 group-hover:bg-teal transition-colors">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.5 2 2 6.1 2 11.2c0 2.9 1.5 5.5 3.8 7.2V22l3.5-1.9c.9.3 1.9.4 2.9.4 5.5 0 10-4.1 10-9.2S17.5 2 12 2zm1 12.4l-2.5-2.7-5 2.7 5.5-5.9 2.6 2.7 4.9-2.7-5.5 5.9z"/></svg>
              </span>
              <span>
                <div class="text-sm font-semibold">Facebook Messenger</div>
                <div class="text-xs text-navy/55">Usually fastest for a quick reply</div>
              </span>
            </a>
          </li>
          <li>
            <a href={CONTACT_PHONE_HREF} class="flex items-center gap-3 group">
              <span class="w-10 h-10 rounded-full bg-navy text-white flex items-center justify-center shrink-0 group-hover:bg-teal transition-colors">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.7 3.6 4.9 6.3 6.3l2.1-2.1c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1L6.6 10.8z"/></svg>
              </span>
              <span>
                <div class="text-sm font-semibold">{CONTACT_PHONE_DISPLAY}</div>
                <div class="text-xs text-navy/55">Call or message</div>
              </span>
            </a>
          </li>
          <li>
            <a href={`mailto:${CONTACT_EMAIL}`} class="flex items-center gap-3 group">
              <span class="w-10 h-10 rounded-full bg-navy text-white flex items-center justify-center shrink-0 group-hover:bg-teal transition-colors">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2 5c0-.6.4-1 1-1h18c.6 0 1 .4 1 1v14c0 .6-.4 1-1 1H3c-.6 0-1-.4-1-1V5zm2.4.5L12 11l7.6-5.5H4.4zM20 7.3l-7.4 5.4a1 1 0 01-1.2 0L4 7.3V18h16V7.3z"/></svg>
              </span>
              <span>
                <div class="text-sm font-semibold">{CONTACT_EMAIL}</div>
                <div class="text-xs text-navy/55">For detailed inquiries</div>
              </span>
            </a>
          </li>
        </ul>

        {SHOW_SOCIAL_LINKS && (
          <div class="mt-8 pt-8 border-t border-navy/10">
            <div class="text-xs uppercase tracking-widest text-navy/50 font-semibold mb-4">Follow us</div>
            <div class="flex gap-3">
              {SOCIAL_LINKS.facebook && <a href={SOCIAL_LINKS.facebook} class="text-sm text-navy/70 hover:text-coral">Facebook</a>}
              {SOCIAL_LINKS.instagram && <a href={SOCIAL_LINKS.instagram} class="text-sm text-navy/70 hover:text-coral">Instagram</a>}
              {SOCIAL_LINKS.tiktok && <a href={SOCIAL_LINKS.tiktok} class="text-sm text-navy/70 hover:text-coral">TikTok</a>}
              {SOCIAL_LINKS.linkedin && <a href={SOCIAL_LINKS.linkedin} class="text-sm text-navy/70 hover:text-coral">LinkedIn</a>}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="relative bg-navy text-white overflow-hidden">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-24 text-center">
      <h2 class="font-display text-3xl md:text-4xl leading-tight">Tell us about your project.</h2>
      <p class="mt-4 text-white/65">We read every message — expect a reply within one business day.</p>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const btn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status || !btn) return;

    const accessKey = (form.querySelector('[name="access_key"]') as HTMLInputElement)?.value;
    if (!accessKey || accessKey.startsWith('REPLACE_WITH')) {
      status.textContent = "Form isn't fully connected yet — please reach us via Messenger, phone, or email above in the meantime.";
      status.className = 'text-sm mt-3 text-coral';
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Sending…';
    status.textContent = '';

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const result = await res.json();
      if (result.success) {
        status.textContent = "Thanks — we've received your message and will get back to you shortly.";
        status.className = 'text-sm mt-3 text-teal-dark';
        form.reset();
      } else {
        throw new Error(result.message || 'Something went wrong');
      }
    } catch {
      status.textContent = 'Something went wrong sending this. Please try Messenger, phone, or email instead.';
      status.className = 'text-sm mt-3 text-coral';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send Message';
    }
  });
</script>
