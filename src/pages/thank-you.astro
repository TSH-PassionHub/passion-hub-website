---
import Layout from '../layouts/Layout.astro';
import { pageMeta } from '../lib/config';
---

<Layout title={pageMeta.thankYou.title} description={pageMeta.thankYou.description}>
  <section class="relative bg-navy text-white overflow-hidden">
    <div class="absolute inset-0 opacity-[0.07]" style="background-image: repeating-linear-gradient(115deg, transparent, transparent 40px, white 41px, white 42px);"></div>
    <div class="max-w-3xl mx-auto px-6 py-28 md:py-36 relative text-center">
      <div class="flex items-center justify-center gap-3 mb-8">
        <span class="h-px w-10 bg-coral"></span>
        <span class="text-xs uppercase tracking-[0.2em] text-teal font-semibold">Message Sent</span>
        <span class="h-px w-10 bg-coral"></span>
      </div>
      <h1 class="font-display text-4xl md:text-6xl leading-tight">
        Thanks — We've Got <span class="accent-slant text-teal">Your Message.</span>
      </h1>
      <p class="mt-8 text-lg text-white/75 max-w-xl mx-auto leading-relaxed">
        We read every message and reply within one business day. In the meantime, here's a bit more about what we do.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/" class="inline-flex items-center justify-center border border-white/30 text-white text-sm font-semibold px-6 py-3 rounded-sm hover:bg-white/10 transition-colors">Home</a>
        <a href="/about" class="inline-flex items-center justify-center border border-white/30 text-white text-sm font-semibold px-6 py-3 rounded-sm hover:bg-white/10 transition-colors">About</a>
        <a href="/services" class="inline-flex items-center justify-center border border-white/30 text-white text-sm font-semibold px-6 py-3 rounded-sm hover:bg-white/10 transition-colors">Services</a>
        <a href="/insights" class="inline-flex items-center justify-center border border-white/30 text-white text-sm font-semibold px-6 py-3 rounded-sm hover:bg-white/10 transition-colors">Insights</a>
      </div>
    </div>
  </section>
</Layout>
