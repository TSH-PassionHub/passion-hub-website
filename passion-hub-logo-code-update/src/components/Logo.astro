---
interface Props {
  variant?: 'full' | 'mark';
  class?: string;
}
const { variant = 'full', class: className = '' } = Astro.props;
---

{variant === 'full' ? (
  <div class={`flex items-center gap-3 ${className}`}>
    <img src="/images/general/header-logo.png" alt="Passion Hub" width="200" height="60" class="h-10 w-auto" />
  </div>
) : (
  <img src="/images/general/favicon-source.png" alt="Passion Hub" width="512" height="512" class={`h-10 w-10 ${className}`} />
)}
